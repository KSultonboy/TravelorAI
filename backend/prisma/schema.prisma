generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum AuthCodeType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  EMAIL_CHANGE
  ACCOUNT_DELETE
}

enum FeedbackCategory {
  suggestion
  complaint
  bug
  feature
  other
}

model User {
  id                       String          @id @default(cuid())
  name                     String
  lastName                 String?
  bio                      String?
  avatarUrl                String?
  email                    String          @unique
  pendingEmail             String?         @unique
  password                 String?
  googleId                 String?         @unique
  authProvider             AuthProvider    @default(LOCAL)
  emailVerified            Boolean         @default(false)
  emailVerifiedAt          DateTime?
  lastLoginAt              DateTime?
  blocked                  Boolean         @default(false)
  failedLoginAttempts      Int             @default(0)
  lastFailedLoginAt        DateTime?
  lockoutUntil             DateTime?
  lockoutLevel             Int             @default(0)
  role                     String          @default("traveler")
  expoPushToken            String?
  emailChangeResendCount   Int             @default(0)
  emailChangeRequestedAt   DateTime?
  accountDeleteResendCount Int             @default(0)
  accountDeleteRequestedAt DateTime?
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt
  trips                    Trip[]
  authCodes                AuthCode[]
  preference               UserPreference?
  wishlistItems            WishlistItem[]
  feedback                 Feedback[]
  tripReviews              TripReview[]
  tourBookings             TourBooking[]
}

model AuthCode {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      AuthCodeType
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime     @default(now())

  @@index([userId, type])
  @@index([expiresAt])
}

model AgencyAccount {
  id                     String              @id @default(cuid())
  email                  String              @unique
  pendingEmail           String?             @unique
  passwordHash           String
  googleId               String?             @unique
  emailVerified          Boolean             @default(false)
  emailVerifiedAt        DateTime?
  emailChangeResendCount Int                 @default(0)
  emailChangeRequestedAt DateTime?
  status                 String              @default("pending")
  mustChangePassword     Boolean             @default(false)
  lastLoginAt            DateTime?
  failedLoginAttempts    Int                 @default(0)
  lastFailedLoginAt      DateTime?
  lockoutUntil           DateTime?
  lockoutLevel           Int                 @default(0)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  authCodes              AgencyAuthCode[]
  applications           AgencyApplication[]
  agencies               TourAgency[]
  memberships            AgencyMember[]

  @@index([status])
  @@index([emailVerified])
}

model AgencyMember {
  id                  String                 @id @default(cuid())
  agencyId            String
  agency              TourAgency             @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  accountId           String
  account             AgencyAccount          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name                String
  role                String                 @default("agent") // manager | agent | accountant (owner emas — u ownerAccountId)
  status              String                 @default("active")
  branchId            String?
  branch              AgencyBranch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  assignedBookings    TourBooking[]          @relation("AssignedLeadManager")
  assignedTasks       CrmTask[]              @relation("AssignedTaskManager")
  commissionRule      ManagerCommissionRule?
  payrollProfile      ManagerPayrollProfile?
  financeTransactions FinanceTransaction[]

  @@unique([agencyId, accountId])
  @@index([agencyId])
  @@index([accountId])
  @@index([agencyId, branchId])
}

model AgencyAuthCode {
  id        String        @id @default(cuid())
  accountId String
  account   AgencyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type      AuthCodeType
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([accountId, type])
  @@index([expiresAt])
}

model AgencyApplication {
  id            String        @id @default(cuid())
  accountId     String
  account       AgencyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  agencyId      String?
  agency        TourAgency?   @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  companyName   String
  legalName     String?
  contactPerson String
  phone         String
  email         String
  city          String
  country       String        @default("Global")
  website       String?
  telegram      String?
  instagram     String?
  serviceTypes  String[]      @default([])
  description   String
  imageUrl      String?
  documents     Json?
  status        String        @default("draft")
  adminNote     String?
  submittedAt   DateTime?
  reviewedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([accountId])
  @@index([agencyId])
  @@index([status, submittedAt])
}

model Destination {
  id              String    @id @default(cuid())
  slug            String    @unique
  name            String
  region          String
  description     String
  imageUrl        String
  rating          Float
  reviewCount     Int
  categories      String[]
  tags            String[]
  budgetDaily     Int
  midDaily        Int
  luxuryDaily     Int
  trainPrice      Int       @default(0)
  trainDuration   String    @default("")
  busPrice        Int       @default(0)
  busDuration     String    @default("")
  flightPrice     Int       @default(0)
  flightDuration  String    @default("")
  landmarks       Json
  hotels          Json
  foodBudget      Int       @default(0)
  foodMid         Int       @default(0)
  foodLuxury      Int       @default(0)
  bestSeasons     String[]
  minDays         Int
  maxDays         Int
  source          String    @default("manual")
  sourceUrl       String?
  lastVerifiedAt  DateTime?
  confidenceScore Float     @default(0.65)
  verifiedBy      String?
  seasonality     Json?
  openingHours    Json?
  priceUpdatedAt  DateTime?
  coverageTier    String    @default("starter")
  createdAt       DateTime  @default(now())
}

model Trip {
  id              String       @id @default(cuid())
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  totalCost       Int
  perPersonCost   Int
  budgetUsed      Float
  budgetRemaining Int
  style           String
  travelers       Int
  duration        Int
  planData        Json
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  tripReviews     TripReview[]
}

model UserPreference {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  style     String   @default("mid")
  interests String[]
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model Poi {
  id               String    @id @default(cuid())
  name             String
  city             String
  slug             String
  type             String
  subtype          String?
  lat              Float
  lng              Float
  info             String
  description      String?
  imageUrl         String?
  rating           Float?
  ratingCount      Int?
  priceLevel       Int?
  price            Int?
  icon             String
  openingHours     Json?
  source           String    @default("manual")
  sourceUrl        String?
  lastVerifiedAt   DateTime?
  confidenceScore  Float     @default(0.55)
  verifiedBy       String?
  duplicateGroupId String?
  priceUpdatedAt   DateTime?
  featured         Boolean   @default(false)
  manualBoost      Float     @default(0)
  qualityScore     Float     @default(0.7)
  landingSortOrder Int       @default(0)
  landingActive    Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  wishlistItems WishlistItem[]

  @@index([type])
  @@index([subtype])
  @@index([city])
  @@index([slug])
  @@index([confidenceScore])
  @@index([duplicateGroupId])
  @@index([featured])
  @@index([landingActive, landingSortOrder])
}

model TransportProvider {
  id              String           @id @default(cuid())
  slug            String           @unique
  name            String
  type            String
  website         String?
  supportPhone    String?
  source          String           @default("manual")
  sourceUrl       String?
  lastVerifiedAt  DateTime?
  confidenceScore Float            @default(0.65)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  routes          TransportRoute[]
}

model TransportRoute {
  id              String             @id @default(cuid())
  fromCity        String
  toCity          String
  mode            String
  providerId      String?
  provider        TransportProvider? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  priceMin        Int
  priceMax        Int
  durationMinutes Int
  distanceKm      Float?
  scheduleNote    String
  bookingUrl      String?
  source          String             @default("manual")
  sourceUrl       String?
  lastVerifiedAt  DateTime?
  confidenceScore Float              @default(0.6)
  whyRecommended  String?
  active          Boolean            @default(true)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([fromCity, toCity])
  @@index([mode])
  @@index([active])
}

model CityPack {
  id                  String   @id @default(cuid())
  city                String   @unique
  version             Int      @default(1)
  offlineReady        Boolean  @default(false)
  poiCount            Int      @default(0)
  destinationCount    Int      @default(0)
  transportRouteCount Int      @default(0)
  emergencyContacts   Json?
  transportNotes      Json?
  sourceSummary       Json?
  updatedAt           DateTime @updatedAt
  createdAt           DateTime @default(now())
}

model HomeHeroSlide {
  id              String    @id @default(cuid())
  slug            String    @unique
  title           String
  subtitle        String?
  imageUrl        String
  actionUrl       String?
  placeSlug       String?
  sortOrder       Int       @default(0)
  active          Boolean   @default(true)
  source          String    @default("admin")
  sourceUrl       String?
  lastVerifiedAt  DateTime?
  confidenceScore Float     @default(0.8)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([active, sortOrder])
}

model TravelerStory {
  id              String    @id @default(cuid())
  slug            String    @unique
  quote           String
  authorName      String
  authorRole      String
  avatar          String?
  avatarColor     String?
  rating          Int       @default(5)
  sortOrder       Int       @default(0)
  active          Boolean   @default(true)
  source          String    @default("admin")
  sourceUrl       String?
  lastVerifiedAt  DateTime?
  confidenceScore Float     @default(0.8)
  featured        Boolean   @default(false)
  manualBoost     Float     @default(0)
  qualityScore    Float     @default(0.8)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([active, sortOrder])
  @@index([featured])
}

model TourAgency {
  id                      String                    @id @default(cuid())
  slug                    String                    @unique
  ownerAccountId          String?
  ownerAccount            AgencyAccount?            @relation(fields: [ownerAccountId], references: [id], onDelete: SetNull)
  name                    String
  city                    String
  description             String?
  specialty               String
  rating                  Float                     @default(0)
  reviews                 Int                       @default(0)
  toursCount              Int                       @default(0)
  phone                   String?
  telegram                String?
  telegramBotToken        String?
  telegramBotUsername     String?
  telegramBotActive       Boolean                   @default(false)
  telegramWelcome         String?
  telegramConfig          String?
  // Instagram Direct → lid. OAuth bilan ulanadi, token 60 kunlik —
  // shuning uchun Telegram'dan farqli o'laroq muddat ustuni bor.
  instagramUserId         String?
  // GET /me ikki xil id qaytaradi: `user_id` (IG professional akkaunt id'si,
  // yuqoridagi ustun) va `id` (app doirasidagi id). Webhook `recipient.id`da
  // qaysi birini yuborishi Meta tomonidan kafolatlanmagan, shuning uchun
  // ikkalasini ham saqlaymiz va webhook ikkalasi bo'yicha qidiradi.
  instagramAppScopedId    String?
  instagramUsername       String?
  instagramToken          String?
  instagramTokenExpiresAt DateTime?
  instagramActive         Boolean                   @default(false)
  instagramWelcome        String?
  whatsappPhoneNumberId   String?
  whatsappWabaId          String?
  whatsappDisplayPhone    String?
  whatsappToken           String?
  whatsappActive          Boolean                   @default(false)
  whatsappWelcome         String?
  birthdayTemplate        String? // tug'ilgan kun tabrigi matni ({name}, {agency})
  notifyChatId            String? // agent xabarnoma oladigan Telegram chat (mijoz lidi EMAS)
  tariffId                String?
  subscriptionStatus      String                    @default("none")
  subscriptionUntil       DateTime?
  website                 String?
  imageUrl                String?
  active                  Boolean                   @default(true)
  source                  String                    @default("admin")
  sourceUrl               String?
  lastVerifiedAt          DateTime?
  confidenceScore         Float                     @default(0.7)
  featured                Boolean                   @default(false)
  manualBoost             Float                     @default(0)
  qualityScore            Float                     @default(0.7)
  landingSortOrder        Int                       @default(0)
  approvalStatus          String                    @default("approved")
  approvedAt              DateTime?
  rejectedAt              DateTime?
  adminNote               String?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  tours                   Tour[]
  applications            AgencyApplication[]
  bookings                TourBooking[]
  tariff                  Tariff?                   @relation(fields: [tariffId], references: [id], onDelete: SetNull)
  payments                AgencyPayment[]
  members                 AgencyMember[]
  presentations           TourPresentation[]
  crmTasks                CrmTask[]
  leadActivities          LeadActivity[]
  leadTags                LeadTag[]
  documentTemplates       DocumentTemplate[]
  requisite               AgencyRequisite?
  auditLogs               AuditLog[]
  crmSettings             AgencyCrmSettings?
  csvImports              CsvImportBatch[]
  financeAccounts         FinanceAccount[]
  financeTransactions     FinanceTransaction[]
  bankStatementImports    BankStatementImport[]
  bankStatementRows       BankStatementRow[]
  businessDocuments       BusinessDocument[]
  suppliers               AgencySupplier[]
  managerCommissionRules  ManagerCommissionRule[]
  documentPayments        BusinessDocumentPayment[]
  documentArchives        BusinessDocumentArchive[]
  documentApprovals       DocumentApproval[]
  documentSignatures      DocumentSignature[]
  automationRules         AutomationRule[]
  automationRuns          AutomationRun[]
  publicApiKeys           PublicApiKey[]
  webhookEndpoints        WebhookEndpoint[]
  webhookEvents           WebhookEvent[]
  branches                AgencyBranch[]
  managerPayrollProfiles  ManagerPayrollProfile[]

  @@index([active])
  @@index([tariffId])
  @@index([subscriptionStatus])
  @@index([city])
  @@index([rating])
  @@index([featured])
  @@index([landingSortOrder])
  @@index([ownerAccountId])
  @@index([approvalStatus])
  @@index([instagramUserId])
  @@index([instagramAppScopedId])
  @@index([whatsappPhoneNumberId])
}

model Tariff {
  id              String          @id @default(cuid())
  name            String
  slug            String          @unique
  priceMonthly    Int             @default(0)
  /// Oylik narx O'zbekiston so'mida — CLICK/Payme to'lovlari faqat so'mda.
  priceMonthlyUzs Int             @default(0)
  commissionPct   Float           @default(15)
  features        String?
  sortOrder       Int             @default(0)
  active          Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  agencies        TourAgency[]
  payments        AgencyPayment[]

  @@index([active])
  @@index([sortOrder])
}

model AgencyPayment {
  id           String     @id @default(cuid())
  agencyId     String
  agency       TourAgency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  tariffId     String?
  tariff       Tariff?    @relation(fields: [tariffId], references: [id], onDelete: SetNull)
  amount       Int
  currency     String     @default("USD")
  periodMonths Int        @default(1)
  method       String?
  note         String?
  paidAt       DateTime   @default(now())
  createdAt    DateTime   @default(now())

  @@index([agencyId])
  @@index([tariffId])
  @@index([paidAt])
}

/// CLICK (SHOP API) to'lov tranzaksiyalari — Prepare/Complete oqimi.
/// Relation YO'Q (prod DB divergent) — agencyId/tariffId oddiy String.
model ClickTransaction {
  id              String    @id @default(cuid())
  provider        String    @default("click")
  /// Bizning buyurtma raqami — CLICK'ga transaction_param sifatida ketadi
  merchantTransId String    @unique
  agencyId        String
  tariffId        String?
  tariffSlug      String?
  /// Summa so'mda (butun son)
  amount          Int
  months          Int       @default(1)
  /// created | prepared | paid | cancelled
  state           String    @default("created")
  clickTransId    String?
  clickPaydocId   String?
  /// Prepare bosqichida biz qaytargan merchant_prepare_id (int)
  prepareId       Int?
  confirmId       Int?
  errorNote       String?
  createdAt       DateTime  @default(now())
  preparedAt      DateTime?
  paidAt          DateTime?
  cancelledAt     DateTime?

  @@index([agencyId])
  @@index([state])
  @@index([clickTransId])
}

model LandingInteraction {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  eventType  String
  weight     Float    @default(1)
  sessionId  String?
  userId     String?
  source     String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([eventType, createdAt])
  @@index([sessionId, createdAt])
}

model Tour {
  id                  String             @id @default(cuid())
  slug                String             @unique
  title               String
  city                String
  subtitle            String
  description         String?
  duration            String
  responseTimeMinutes Int                @default(45)
  price               String?
  priceMin            Int?
  priceCurrency       String?
  priceBasis          String?
  rating              Float              @default(0)
  badge               String             @default("Latest")
  imageUrl            String?
  itinerary           Json?
  highlights          String[]           @default([])
  departureCity       String?
  destinationCountry  String?
  tourGroup           String?
  nights              Int?
  /// Kun soni — katalog «1-3 / 4-7 / 7+ kun» filtri aynan shu maydonga qaraydi.
  days                Int?
  hotelIncluded       Boolean            @default(false)
  /// Aviabilet kiritilganmi — tur sahifasidagi «Nimalar kiritilgan» shundan.
  flightIncluded      Boolean            @default(false)
  /// Transfer (aeroport ⇄ mehmonxona) kiritilganmi.
  transferIncluded    Boolean            @default(false)
  /// Sayohat sug'urtasi kiritilganmi.
  insuranceIncluded   Boolean            @default(false)
  hotelName           String?
  hotelCategory       String?
  hotelLocation       String?
  roomType            String?
  mealPlan            String?
  mealPlanLabel       String?
  childPolicy         String?
  flightSeatStatus    String?
  availabilityStatus  String?
  instantConfirmation Boolean            @default(false)
  stopSale            Boolean            @default(false)
  promo               Boolean            @default(false)
  priceIncludes       String[]           @default([])
  priceExcludes       String[]           @default([])
  images              String[]           @default([]) // galereya (asosiy rasmdan tashqari)
  mapAddress          String? // xarita uchun matn manzil (geokodlash shart emas)
  routeStops          Json? // marshrut nuqtalari: [{name, lat, lng}] — chiziq bilan bog'lanadi
  active              Boolean            @default(true)
  agencyId            String?
  agency              TourAgency?        @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  approvalStatus      String             @default("approved")
  submittedAt         DateTime?
  approvedAt          DateTime?
  rejectedAt          DateTime?
  adminNote           String?
  source              String             @default("admin")
  sourceUrl           String?
  lastVerifiedAt      DateTime?
  confidenceScore     Float              @default(0.7)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  bookings            TourBooking[]
  presentations       TourPresentation[]

  @@index([active])
  @@index([badge])
  @@index([city])
  @@index([rating])
  @@index([agencyId])
  @@index([approvalStatus])
  @@index([active, approvalStatus])
}

model TourBooking {
  id                 String      @id @default(cuid())
  tourId             String?
  tour               Tour?       @relation(fields: [tourId], references: [id], onDelete: Cascade)
  agencyId           String?
  agency             TourAgency? @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  userId             String?
  user               User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName       String
  customerEmail      String?
  customerPhone      String?
  travelers          Int         @default(1)
  travelDate         DateTime?
  message            String?
  status             String      @default("pending")
  responseDeadlineAt DateTime?
  totalEstimate      Int?
  currency           String      @default("USD")
  source             String      @default("mobile")
  agencyNote         String?
  adminNote          String?
  confirmedAt        DateTime?
  rejectedAt         DateTime?
  cancelledAt        DateTime?
  completedAt        DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  pipelineStage       String               @default("new")
  leadTour            String?
  leadCity            String? // qo'lda kiritilgan shahar (bog'langan tur bo'lmasa)
  leadTelegram        String? // mijoz Telegram: @username yoki link
  leadWhatsapp        String? // mijoz WhatsApp raqami (telefondan farqli bo'lishi mumkin)
  paidAmount          Int? // haqiqatda olingan to'lov (to'lovni tasdiqlashda kiritiladi)
  archived            Boolean              @default(false) // arxivlangan — kanbandan chiqadi
  archivedAt          DateTime?
  telegramChatId      String?
  instagramUserId     String? // IGSID — app+akkaunt juftligiga bog'liq, ochiq profil id'si EMAS
  instagramUsername   String?
  utmSource           String? // qayerdan keldi: instagram, telegram, google...
  utmMedium           String? // cpc, post, story, bio...
  utmCampaign         String? // kampaniya nomi
  referrer            String? // qaysi saytdan o'tdi
  customerBirthday    DateTime? // mijoz tug'ilgan kuni (tabrik uchun)
  birthdayGreetedOn   String? // oxirgi tabrik sanasi (YYYY-MM-DD) — takror bo'lmasin
  tripReminderSentAt  DateTime? // sayohat eslatmasi yuborilgan vaqt
  reviewRequestedAt   DateTime? // baho so'rovi yuborilgan vaqt (takror bo'lmasin)
  reviewAwaitingText  Boolean              @default(false) // baho berildi, keyingi xabar sharh matni
  assignedMemberId    String?
  assignedMember      AgencyMember?        @relation("AssignedLeadManager", fields: [assignedMemberId], references: [id], onDelete: SetNull)
  branchId            String?
  branch              AgencyBranch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  firstResponseAt     DateTime?
  slaBreachedAt       DateTime?
  slaReminderAt       DateTime?
  whatsappWaId        String?
  csvImportBatchId    String?
  csvImportBatch      CsvImportBatch?      @relation(fields: [csvImportBatchId], references: [id], onDelete: SetNull)
  presentations       TourPresentation[]
  crmTasks            CrmTask[]
  activities          LeadActivity[]
  leadTags            LeadTag[]
  financeTransactions FinanceTransaction[]
  businessDocuments   BusinessDocument[]

  @@index([tourId])
  @@index([agencyId, status])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([customerEmail])
  @@index([agencyId, assignedMemberId])
  @@index([agencyId, branchId])
  @@index([instagramUserId])
  @@index([whatsappWaId])
  @@index([agencyId, firstResponseAt, createdAt])
  @@index([csvImportBatchId])
}

// SLA va avtomatik biriktirish agentlik kesimida boshqariladi.
model AgencyCrmSettings {
  id                   String     @id @default(cuid())
  agencyId             String     @unique
  agency               TourAgency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  firstResponseMinutes Int        @default(30)
  autoAssignEnabled    Boolean    @default(false)
  roundRobinCursor     Int        @default(0)
  reminderEnabled      Boolean    @default(true)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
}

// Agentlik egasi UI orqali tuzadigan no-code trigger -> shart -> amal qoidasi.
model AutomationRule {
  id                 String             @id @default(cuid())
  agencyId           String
  agency             TourAgency         @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  name               String
  active             Boolean            @default(true)
  triggerType        String
  triggerConfig      Json
  conditionMode      String             @default("all") // all | any
  conditions         Json
  maxAttempts        Int                @default(3)
  createdByAccountId String?
  lastRunAt          DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  actions            AutomationAction[]
  runs               AutomationRun[]

  @@index([agencyId, active, triggerType])
  @@index([agencyId, createdAt])
}

// Qoidaning ketma-ket bajariladigan amallari. Config amal turiga qarab farq qiladi.
model AutomationAction {
  id        String         @id @default(cuid())
  ruleId    String
  rule      AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  type      String
  config    Json
  sortOrder Int            @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([ruleId, sortOrder])
}

// Har bir entity/event uchun idempotent run, natija va retry holati.
model AutomationRun {
  id          String         @id @default(cuid())
  agencyId    String
  agency      TourAgency     @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  ruleId      String
  rule        AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  eventKey    String
  triggerType String
  entityType  String
  entityId    String
  status      String         @default("pending") // pending | running | success | failed | skipped
  attempt     Int            @default(0)
  input       Json?
  output      Json?
  error       String?
  nextRetryAt DateTime?
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([ruleId, eventKey])
  @@index([agencyId, status, createdAt])
  @@index([status, nextRetryAt])
  @@index([entityType, entityId])
}

// Tashqi integratorlar uchun scope bilan cheklangan, qayta ko‘rsatib bo‘lmaydigan API kalit.
// DB'da raw kalit emas, faqat SHA-256 hash va foydalanuvchiga ko‘rinadigan prefix saqlanadi.
model PublicApiKey {
  id                 String     @id @default(cuid())
  agencyId           String
  agency             TourAgency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  name               String
  keyPrefix          String
  keyHash            String     @unique
  scopes             String[]
  rateLimitPerMinute Int        @default(120)
  createdByAccountId String?
  lastUsedAt         DateTime?
  expiresAt          DateTime?
  revokedAt          DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([agencyId, revokedAt, createdAt])
}

// Agentlik ulagan outbound webhook manzili. Secret AES-256-GCM bilan shifrlanadi.
model WebhookEndpoint {
  id                 String            @id @default(cuid())
  agencyId           String
  agency             TourAgency        @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  name               String
  url                String
  active             Boolean           @default(true)
  events             String[]
  secretEncrypted    String
  secretPrefix       String
  maxAttempts        Int               @default(6)
  createdByAccountId String?
  lastSuccessAt      DateTime?
  lastFailureAt      DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  deliveries         WebhookDelivery[]

  @@index([agencyId, active, createdAt])
}

// Transactional outbox: biznes hodisasi deliverylardan alohida saqlanadi.
model WebhookEvent {
  id         String            @id @default(cuid())
  agencyId   String
  agency     TourAgency        @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  type       String
  entityType String?
  entityId   String?
  payload    Json
  createdAt  DateTime          @default(now())
  deliveries WebhookDelivery[]

  @@index([agencyId, createdAt])
  @@index([agencyId, type, createdAt])
}

// Har endpoint/event juftligi uchun delivery, retry va DLQ holati.
model WebhookDelivery {
  id             String          @id @default(cuid())
  endpointId     String
  endpoint       WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  eventId        String
  event          WebhookEvent    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  status         String          @default("pending") // pending | sending | retry | success | dead
  attempt        Int             @default(0)
  maxAttempts    Int             @default(6)
  nextAttemptAt  DateTime        @default(now())
  responseStatus Int?
  responseBody   String?
  error          String?
  durationMs     Int?
  deliveredAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([endpointId, eventId])
  @@index([status, nextAttemptAt])
  @@index([endpointId, createdAt])
  @@index([eventId])
}

// CSV import avval preview qilinadi, keyin batch sifatida commit bo'ladi.
// Batchga bog'langan lidlar keyinchalik xavfsiz rollback qilinadi.
model CsvImportBatch {
  id             String        @id @default(cuid())
  agencyId       String
  agency         TourAgency    @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  actorAccountId String?
  fileName       String?
  status         String        @default("committed") // committed | rolled_back
  totalRows      Int
  importedRows   Int
  duplicateRows  Int           @default(0)
  invalidRows    Int           @default(0)
  mapping        Json?
  preview        Json?
  rolledBackAt   DateTime?
  createdAt      DateTime      @default(now())
  bookings       TourBooking[]

  @@index([agencyId, createdAt])
  @@index([agencyId, status])
}

// CRM vazifalari — barcha xodimlar uchun serverda sinxron saqlanadi.
model CrmTask {
  id                 String        @id @default(cuid())
  agencyId           String
  agency             TourAgency    @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  bookingId          String?
  booking            TourBooking?  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  assignedMemberId   String?
  assignedMember     AgencyMember? @relation("AssignedTaskManager", fields: [assignedMemberId], references: [id], onDelete: SetNull)
  createdByAccountId String?
  title              String
  dueAt              DateTime?
  completedAt        DateTime?
  externalId         String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@unique([agencyId, externalId])
  @@index([agencyId, completedAt, dueAt])
  @@index([bookingId])
  @@index([assignedMemberId])
}

// Lid tarixi: izoh, qo'ng'iroq, bosqich o'zgarishi va import hodisalari.
model LeadActivity {
  id             String      @id @default(cuid())
  agencyId       String
  agency         TourAgency  @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  bookingId      String
  booking        TourBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  actorAccountId String?
  type           String      @default("note")
  text           String
  metadata       Json?
  externalId     String?
  createdAt      DateTime    @default(now())

  @@unique([agencyId, externalId])
  @@index([agencyId, bookingId, createdAt])
}

// Har bir lidga biriktirilgan teglar. Bir lidda bir xil teg takrorlanmaydi.
model LeadTag {
  id        String      @id @default(cuid())
  agencyId  String
  agency    TourAgency  @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  bookingId String
  booking   TourBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime    @default(now())

  @@unique([bookingId, name])
  @@index([agencyId, name])
}

// Shartnoma, invoice va boshqa hujjatlar uchun agentlik shablonlari.
model DocumentTemplate {
  id        String     @id @default(cuid())
  agencyId  String
  agency    TourAgency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  type      String
  name      String
  content   String
  metadata  Json?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([agencyId, type])
  @@index([agencyId])
}

// Agentlikning hujjatlarda ishlatiladigan yuridik va bank rekvizitlari.
model AgencyRequisite {
  id          String     @id @default(cuid())
  agencyId    String     @unique
  agency      TourAgency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  legalName   String?
  director    String?
  address     String?
  taxId       String?
  bankName    String?
  bankAccount String?
  mfo         String?
  phone       String?
  email       String?
  extra       Json?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

// Agentlik portalidagi barcha muvaffaqiyatli yozuv amallari uchun audit izi.
model AuditLog {
  id             String     @id @default(cuid())
  agencyId       String
  agency         TourAgency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  actorAccountId String?
  actorEmail     String?
  action         String
  entityType     String?
  entityId       String?
  requestPath    String?
  requestMethod  String?
  changes        Json?
  ipAddress      String?
  userAgent      String?
  dedupeKey      String?    @unique
  createdAt      DateTime   @default(now())

  @@index([agencyId, createdAt])
  @@index([agencyId, entityType, entityId])
  @@index([actorAccountId, createdAt])
}

// Agentlikning kassa, bank va elektron hamyonlari. openingBalance bir xil
// valyutadagi tranzaksiyalar bilan birga hisoblanadi.
model FinanceAccount {
  id               String                @id @default(cuid())
  agencyId         String
  agency           TourAgency            @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  branchId         String?
  branch           AgencyBranch?         @relation(fields: [branchId], references: [id], onDelete: SetNull)
  name             String
  type             String                @default("cash") // cash | bank | card | wallet
  currency         String                @default("USD")
  openingBalance   Int                   @default(0)
  active           Boolean               @default(true)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  transactions     FinanceTransaction[]
  statementImports BankStatementImport[]

  @@unique([agencyId, name, currency])
  @@index([agencyId, active])
  @@index([agencyId, branchId])
}

// Agentlikning operatsion moliyasi. direction kirim/chiqimni, status esa
// rejalashtirilgan yoki amalda to'langanligini ifodalaydi.
model FinanceTransaction {
  id                     String                   @id @default(cuid())
  agencyId               String
  agency                 TourAgency               @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  branchId               String?
  branch                 AgencyBranch?            @relation(fields: [branchId], references: [id], onDelete: SetNull)
  accountId              String?
  account                FinanceAccount?          @relation(fields: [accountId], references: [id], onDelete: SetNull)
  bookingId              String?
  booking                TourBooking?             @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  businessDocumentId     String?
  businessDocument       BusinessDocument?        @relation(fields: [businessDocumentId], references: [id], onDelete: SetNull)
  supplierId             String?
  supplier               AgencySupplier?          @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  managerMemberId        String?
  managerMember          AgencyMember?            @relation(fields: [managerMemberId], references: [id], onDelete: SetNull)
  commissionSourceId     String?                  @unique
  direction              String // income | expense
  status                 String                   @default("planned") // planned | paid | cancelled
  category               String
  amount                 Int
  currency               String                   @default("USD")
  counterparty           String?
  paymentMethod          String?
  note                   String?
  dueAt                  DateTime?
  paidAt                 DateTime?
  createdByAccountId     String?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  documentPayment        BusinessDocumentPayment?
  suggestedStatementRows BankStatementRow[]       @relation("StatementSuggestedTransaction")
  matchedStatementRows   BankStatementRow[]       @relation("StatementMatchedTransaction")

  @@index([agencyId, currency, status, dueAt])
  @@index([agencyId, paidAt])
  @@index([bookingId])
  @@index([accountId])
  @@index([businessDocumentId])
  @@index([supplierId])
  @@index([managerMemberId])
  @@index([agencyId, branchId])
}

// Agentlikning bir yoki bir nechta savdo nuqtasi. Asosiy filial ham oddiy
// yozuv bo'lib qoladi, shuning uchun dashboarddagi hisob tarixiy va aniq.
model AgencyBranch {
  id                  String               @id @default(cuid())
  agencyId            String
  agency              TourAgency           @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  name                String
  city                String?
  address             String?
  active              Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  members             AgencyMember[]
  bookings            TourBooking[]
  financeAccounts     FinanceAccount[]
  financeTransactions FinanceTransaction[]

  @@unique([agencyId, name])
  @@index([agencyId, active])
}

// Bank CSV ko‘chirmasi importi. Mapping va sarlavhalar saqlanadi, shuning uchun
// har bir bankning formatini UI orqali bir marta moslab ishlatish mumkin.
model BankStatementImport {
  id                 String             @id @default(cuid())
  agencyId           String
  agency             TourAgency         @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  accountId          String?
  account            FinanceAccount?    @relation(fields: [accountId], references: [id], onDelete: SetNull)
  fileName           String
  currency           String             @default("UZS")
  status             String             @default("processed") // processed | reconciled
  headers            Json
  mapping            Json
  totalRows          Int                @default(0)
  suggestedRows      Int                @default(0)
  matchedRows        Int                @default(0)
  ignoredRows        Int                @default(0)
  createdByAccountId String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  rows               BankStatementRow[]

  @@index([agencyId, createdAt])
  @@index([accountId, createdAt])
}

// Ko‘chirmadagi bitta bank operatsiyasi va CRM tranzaksiyasiga reconciliation.
model BankStatementRow {
  id                     String              @id @default(cuid())
  agencyId               String
  agency                 TourAgency          @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  importId               String
  import                 BankStatementImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  rowNumber              Int
  transactionDate        DateTime
  direction              String // income | expense
  amount                 Int
  currency               String              @default("UZS")
  counterparty           String?
  description            String?
  externalId             String?
  fingerprint            String
  status                 String              @default("unmatched") // unmatched | suggested | matched | ignored | duplicate
  suggestedTransactionId String?
  suggestedTransaction   FinanceTransaction? @relation("StatementSuggestedTransaction", fields: [suggestedTransactionId], references: [id], onDelete: SetNull)
  matchedTransactionId   String?
  matchedTransaction     FinanceTransaction? @relation("StatementMatchedTransaction", fields: [matchedTransactionId], references: [id], onDelete: SetNull)
  matchScore             Int?
  raw                    Json
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  @@unique([importId, rowNumber])
  @@index([agencyId, status])
  @@index([agencyId, fingerprint])
  @@index([suggestedTransactionId])
  @@index([matchedTransactionId])
}

// Turoperator, mehmonxona, aviatashuvchi va boshqa hamkorlar kesimidagi
// qarzdorlikni alohida ko'rish uchun kontragent kartochkasi.
model AgencySupplier {
  id           String               @id @default(cuid())
  agencyId     String
  agency       TourAgency           @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  name         String
  type         String               @default("tour_operator")
  taxId        String?
  phone        String?
  email        String?
  currency     String               @default("USD")
  notes        String?
  active       Boolean              @default(true)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  transactions FinanceTransaction[]

  @@unique([agencyId, name])
  @@index([agencyId, active])
}

// Har bir menejer uchun yopilgan va to'langan bitimdan hisoblanadigan qoida.
model ManagerCommissionRule {
  id          String       @id @default(cuid())
  agencyId    String
  agency      TourAgency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  memberId    String       @unique
  member      AgencyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  percent     Float        @default(0)
  fixedAmount Int          @default(0)
  currency    String       @default("USD")
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([agencyId, active])
}

// Menejer oyligi: bazaviy maosh va har bir yopilgan bitim uchun bonus.
// Foiz/fixed komissiya alohida ManagerCommissionRule orqali hisoblanadi.
model ManagerPayrollProfile {
  id          String       @id @default(cuid())
  agencyId    String
  agency      TourAgency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  memberId    String       @unique
  member      AgencyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  baseSalary  Int          @default(0)
  bonusPerWon Int          @default(0)
  currency    String       @default("USD")
  payoutDay   Int          @default(5)
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([agencyId, active])
}

// Yaratilgan shartnoma, hisob-faktura, voucher va dalolatnomalar reyestri.
// Har bir o'zgarish BusinessDocumentVersion orqali qayta tiklanadigan iz qoldiradi.
model BusinessDocument {
  id                 String                    @id @default(cuid())
  agencyId           String
  agency             TourAgency                @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  bookingId          String?
  booking            TourBooking?              @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  number             String
  type               String // contract | invoice | voucher | act | other
  status             String                    @default("draft") // draft | sent | signed | paid | cancelled
  title              String
  customerName       String?
  amount             Int?
  currency           String                    @default("USD")
  issuedAt           DateTime                  @default(now())
  dueAt              DateTime?
  sentAt             DateTime?
  signedAt           DateTime?
  paidAt             DateTime?
  notes              String?
  currentVersion     Int                       @default(1)
  createdByAccountId String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  versions           BusinessDocumentVersion[]
  transactions       FinanceTransaction[]
  payments           BusinessDocumentPayment[]
  archives           BusinessDocumentArchive[]
  approvals          DocumentApproval[]
  signatures         DocumentSignature[]

  @@unique([agencyId, number])
  @@index([agencyId, type, status, issuedAt])
  @@index([bookingId])
}

// Invoice bo'yicha har bir qisman yoki to'liq to'lov alohida saqlanadi.
model BusinessDocumentPayment {
  id                 String             @id @default(cuid())
  agencyId           String
  agency             TourAgency         @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  businessDocumentId String
  businessDocument   BusinessDocument   @relation(fields: [businessDocumentId], references: [id], onDelete: Cascade)
  transactionId      String             @unique
  transaction        FinanceTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  amount             Int
  currency           String
  paidAt             DateTime           @default(now())
  note               String?
  createdByAccountId String?
  createdAt          DateTime           @default(now())

  @@index([agencyId, paidAt])
  @@index([businessDocumentId, paidAt])
}

// Server yaratgan PDF nusxalari DB'da hash va versiya bilan arxivlanadi.
model BusinessDocumentArchive {
  id                 String           @id @default(cuid())
  agencyId           String
  agency             TourAgency       @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  businessDocumentId String
  businessDocument   BusinessDocument @relation(fields: [businessDocumentId], references: [id], onDelete: Cascade)
  version            Int
  filename           String
  mimeType           String           @default("application/pdf")
  size               Int
  sha256             String
  data               Bytes
  createdByAccountId String?
  createdAt          DateTime         @default(now())

  @@index([agencyId, createdAt])
  @@index([businessDocumentId, version])
}

// Ichki tasdiqlash oqimi: yuborildi -> tasdiqlandi yoki rad etildi.
model DocumentApproval {
  id                 String           @id @default(cuid())
  agencyId           String
  agency             TourAgency       @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  businessDocumentId String
  businessDocument   BusinessDocument @relation(fields: [businessDocumentId], references: [id], onDelete: Cascade)
  requestedById      String?
  decidedById        String?
  status             String           @default("pending")
  comment            String?
  decidedAt          DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([agencyId, status, createdAt])
  @@index([businessDocumentId, createdAt])
}

// Email orqali yuborilgan bir martalik kod bilan tasdiqlangan elektron imzo izi.
model DocumentSignature {
  id                 String           @id @default(cuid())
  agencyId           String
  agency             TourAgency       @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  businessDocumentId String
  businessDocument   BusinessDocument @relation(fields: [businessDocumentId], references: [id], onDelete: Cascade)
  signerName         String
  signerEmail        String
  codeHash           String
  status             String           @default("pending")
  expiresAt          DateTime
  verifiedAt         DateTime?
  attempts           Int              @default(0)
  requestedById      String?
  ipAddress          String?
  userAgent          String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([agencyId, status, createdAt])
  @@index([businessDocumentId, createdAt])
  @@index([signerEmail, expiresAt])
}

model BusinessDocumentVersion {
  id                 String           @id @default(cuid())
  businessDocumentId String
  businessDocument   BusinessDocument @relation(fields: [businessDocumentId], references: [id], onDelete: Cascade)
  version            Int
  content            Json
  createdByAccountId String?
  createdAt          DateTime         @default(now())

  @@unique([businessDocumentId, version])
  @@index([businessDocumentId, createdAt])
}

// Mijoz sharhi + reyting — sayohat "yakunlandi"ga o'tgach Telegram orqali yig'iladi.
// Bog'lanishlarsiz (skalyar agencyId/bookingId) — divergent prod DB uchun xavfsiz.
// Publish bo'lgan sharhlar agentlik reytingini (TourAgency.rating/reviews) oshiradi.
model TourReview {
  id             String   @id @default(cuid())
  agencyId       String
  bookingId      String?  @unique
  rating         Int
  text           String?
  customerName   String?
  telegramChatId String?
  status         String   @default("published") // published | hidden
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([agencyId, status])
}

// Lidga biriktirilgan hujjat/fayl (pasport, viza, shartnoma skani).
// Fayl DB'da (bytea) saqlanadi — PII, shuning uchun ochiq /uploads statik yo'lida
// EMAS; faqat autentifikatsiyalangan endpoint orqali beriladi. Bog'lanishsiz —
// divergent prod DB uchun xavfsiz.
model LeadFile {
  id        String    @id @default(cuid())
  agencyId  String
  bookingId String
  name      String
  mimeType  String
  size      Int
  data      Bytes
  ocrStatus String    @default("none")
  ocrData   Json?
  ocrAt     DateTime?
  ocrError  String?
  createdAt DateTime  @default(now())

  @@index([bookingId])
  @@index([agencyId])
}

// Dinamik taklif (prezentatsiya) — agent mijozga shaxsiy link yuboradi, ochilishi kuzatiladi.
// Public sahifada mijoz telefoni/emaili KO'RSATILMAYDI — faqat ism (agent o'zi kiritadi).
model TourPresentation {
  id            String       @id @default(cuid())
  token         String       @unique
  agencyId      String
  agency        TourAgency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  bookingId     String?
  booking       TourBooking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  tourId        String?
  tour          Tour?        @relation(fields: [tourId], references: [id], onDelete: SetNull)
  title         String
  customerName  String?
  priceText     String?
  note          String?
  status        String       @default("sent") // sent | viewed | interested
  openCount     Int          @default(0)
  firstOpenedAt DateTime?
  lastOpenedAt  DateTime?
  interestedAt  DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([agencyId, createdAt])
  @@index([bookingId])
  @@index([tourId])
}

model WishlistItem {
  id      String   @id @default(cuid())
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  poiId   String?
  poi     Poi?     @relation(fields: [poiId], references: [id], onDelete: SetNull)
  name    String
  city    String
  slug    String
  type    String
  icon    String
  savedAt DateTime @default(now())

  @@unique([userId, slug])
  @@index([userId, savedAt])
}

model Feedback {
  id           String           @id @default(cuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     FeedbackCategory @default(suggestion)
  subject      String?
  message      String
  contactEmail String?
  platform     String?
  appVersion   String?
  createdAt    DateTime         @default(now())

  @@index([userId])
  @@index([category])
  @@index([createdAt])
}

model TripReview {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, tripId])
  @@index([tripId, createdAt])
  @@index([userId, createdAt])
}

// Nomi tarixiy — bu endi UMUMIY xabar jurnali (Telegram + Instagram).
// Prod bazasi divergent, jadvalni qayta nomlash xavfli bo'lgani uchun nom qoldi;
// kanal `channel` ustuni bilan ajratiladi.
model TelegramMessage {
  id          String   @id @default(cuid())
  agencyId    String
  bookingId   String?
  channel     String   @default("telegram") // telegram | instagram | whatsapp
  direction   String
  text        String
  fromName    String?
  externalId  String?  @unique // Meta message id — webhook retry deduplikatsiyasi
  status      String? // sent | delivered | read | failed
  senderId    String?
  recipientId String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([agencyId])
  @@index([bookingId])
  @@index([agencyId, channel, createdAt])
}

PORT=4000
HOST=0.0.0.0
NODE_ENV=development

DATABASE_URL=postgresql://travelorai:travelorai_pass@localhost:5433/travelorai_db
REDIS_URL=redis://localhost:6380

JWT_SECRET=change_me_to_random_long_secret
JWT_EXPIRES_IN=7d
AGENCY_JWT_SECRET=change_me_to_random_long_agency_secret
AGENCY_JWT_EXPIRES_IN=7d
AGENCY_CODE_EXPIRES_MINUTES=10
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8081,http://localhost:19006

APP_NAME=TravelorAI
SUPPORT_EMAIL=support@travelorai.com
MAIL_FROM=support@travelorai.com
EMAIL_VERIFICATION_TTL_MINUTES=10
PASSWORD_RESET_TTL_MINUTES=10

GOOGLE_CLIENT_IDS=
GOOGLE_ANDROID_CLIENT_ID_DEBUG=
GOOGLE_ANDROID_CLIENT_ID_RELEASE=
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
YANDEX_MAPS_API_KEY=
YANDEX_GEOCODER_API_KEY=
YANDEX_GEOSUGGEST_API_KEY=
YANDEX_SEARCH_API_KEY=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

ADMIN_SECRET_KEY=change_me

# Planner AI refinement (Gemini)
GEMINI_PLANNER_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_TIMEOUT_MS=9000

# ─── CLICK to'lov tizimi (shartnoma tuzilgach CLICK beradi) ───────────────
# Kalitlar bo'lmasa to'lov tugmasi kabinetda KO'RINMAYDI (boshqa hech narsa buzilmaydi).
# CLICK kabinetiga ko'rsatiladigan manzillar:
#   Prepare  : https://travelorai.com/api/v1/payments/click/prepare
#   Complete : https://travelorai.com/api/v1/payments/click/complete
# DIQQAT: CLICK_SECRET_KEY faqat backend .env'da tursin — website konteyneriga
# hech qachon uzatilmasin.
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
CLICK_MERCHANT_USER_ID=

# To'lov return sahifasi shu domen ostida yasaladi (payment/return)
PUBLIC_SITE_URL=https://travelorai.com

# Traveler Premium narxi (so'mda, oyiga). 0 => Premium sotuv o'chirilgan.
USER_PREMIUM_PRICE_UZS=29000

PORT=4000
HOST=0.0.0.0
NODE_ENV=development

DATABASE_URL=postgresql://travelorai:travelorai_pass@localhost:5433/travelorai_db
REDIS_URL=redis://localhost:6380

# Maxfiy kalitlar: production'da (NODE_ENV=production) MAJBURIY, kamida 32 belgi,
# ma'lum standart qiymat (change_me, travelorai_secret ...) bo'lmasligi va
# JWT_SECRET != AGENCY_JWT_SECRET bo'lishi shart — aks holda server ishga tushmaydi.
# Yaratish: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Development'da bo'sh qoldirilsa src/config/env.js dagi dev-zaxira ishlatiladi (ogohlantirish bilan).
JWT_SECRET=
JWT_EXPIRES_IN=7d
AGENCY_JWT_SECRET=
AGENCY_JWT_EXPIRES_IN=7d
# Audience/type claim'siz eski tokenlarni qabul qilish (o'tish davri). Deploydan
# 7 kun o'tgach "false" qo'yish mumkin.
AUTH_ACCEPT_LEGACY_TOKENS=true
# Faqat development: emailga ketgan kodni API javobida (devCode) qaytarish.
# Production'da hech qachon ishlamaydi.
ALLOW_DEV_CODES=false
AGENCY_CODE_EXPIRES_MINUTES=10
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8081,http://localhost:19006

APP_NAME=TravelorAI
SUPPORT_EMAIL=support@travelorai.com
MAIL_FROM=support@travelorai.com
EMAIL_VERIFICATION_TTL_MINUTES=10
PASSWORD_RESET_TTL_MINUTES=10

# Google client ID'lari (vergul bilan). Hech biri o'rnatilmasa Google orqali kirish 503 qaytaradi.
GOOGLE_CLIENT_IDS=
GOOGLE_ANDROID_CLIENT_ID_DEBUG=
GOOGLE_ANDROID_CLIENT_ID_RELEASE=
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
YANDEX_MAPS_API_KEY=
YANDEX_GEOCODER_API_KEY=
YANDEX_GEOSUGGEST_API_KEY=
YANDEX_SEARCH_API_KEY=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# Production'da majburiy, kamida 32 belgi (dev'da bo'sh bo'lsa "change_me").
ADMIN_SECRET_KEY=

# Planner AI refinement (Gemini)
GEMINI_PLANNER_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_TIMEOUT_MS=9000

# Meta xabar kanallari
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_VERIFY_TOKEN=
# Instagram va WhatsApp tokenlarini AES-256-GCM bilan saqlash uchun umumiy 32 baytli kalit.
INSTAGRAM_TOKEN_ENCRYPTION_KEY=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
META_GRAPH_VERSION=v23.0

# ─── CLICK to'lov tizimi (shartnoma tuzilgach CLICK beradi) ───────────────
# Kalitlar bo'lmasa to'lov tugmasi kabinetda KO'RINMAYDI (boshqa hech narsa buzilmaydi).
# CLICK kabinetiga ko'rsatiladigan manzillar:
#   Prepare  : https://travelorai.com/api/v1/payments/click/prepare
#   Complete : https://travelorai.com/api/v1/payments/click/complete
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
CLICK_MERCHANT_USER_ID=

# Yangi agentliklar uchun bepul sinov muddati (kun). Eski agentliklarga ta'sir qilmaydi.
TRIAL_DAYS=14

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TravelorAI CRM",
  "version": "1.0.0",
  "identifier": "com.travelorai.crm",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TravelorAI CRM",
        "url": "https://travelorai.com/signin?as=agency",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "TravelorAI",
    "category": "Business",
    "shortDescription": "TravelorAI agentlik CRM",
    "longDescription": "TravelorAI — sayohat agentliklari uchun CRM kabineti (lidlar, mijozlar, hujjatlar, Telegram).",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://travelorai.com/desktop/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUyQTcyNkY4MUNDNTE1QzcKUldUSEZjVWMrQ2FuVXFVNVM1dEZnbXJlc0hzYUNjMHVRTDdZRTZjMUVud2xBMjVqZ25kQnJGODcK"
    }
  }
}

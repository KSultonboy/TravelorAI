FROM node:20-alpine

WORKDIR /app

ARG NEXT_PUBLIC_SITE_URL=https://travelorai.com
ARG NEXT_PUBLIC_API_URL=https://travelorai.com/api/v1
ARG NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=
ARG ADMIN_API_URL=
ARG AGENCY_API_URL=
ARG ADMIN_SECRET_KEY=
ARG ADMIN_SESSION_SECRET=
ARG ADMIN_USERNAME=admin
ARG ADMIN_PASSWORD=admin123

ENV NODE_ENV=production \
    NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL \
    NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=$NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID \
    ADMIN_API_URL=$ADMIN_API_URL \
    AGENCY_API_URL=$AGENCY_API_URL \
    ADMIN_SECRET_KEY=$ADMIN_SECRET_KEY \
    ADMIN_SESSION_SECRET=$ADMIN_SESSION_SECRET \
    ADMIN_USERNAME=$ADMIN_USERNAME \
    ADMIN_PASSWORD=$ADMIN_PASSWORD

COPY package*.json ./
RUN npm ci --include=dev

COPY . .
RUN npm run build

EXPOSE 3000

CMD ["npm", "run", "start", "--", "-p", "3000", "-H", "0.0.0.0"]

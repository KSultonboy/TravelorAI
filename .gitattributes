# Files executed or parsed on Linux must keep LF line endings even on Windows checkouts.
*.sh            text eol=lf
*.service       text eol=lf
*.timer         text eol=lf
*.conf          text eol=lf
Dockerfile      text eol=lf
Containerfile   text eol=lf
.dockerignore   text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf

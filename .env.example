# TravelorAI — root .env for LOCAL docker compose (docker-compose.yml).
#
#   cp .env.example .env      (Windows PowerShell: Copy-Item .env.example .env)
#
# .env is gitignored. Never put production secrets here.
# Generate random values, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ---- Admin panel (website /admin) — REQUIRED, no defaults -----------------
# Choose your own local login. "admin", "admin123", "change_me"... are rejected.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# >= 32 random characters
ADMIN_SESSION_SECRET=
# Shared key the website uses to call backend admin endpoints (>= 32 chars).
ADMIN_SECRET_KEY=

# ---- Host ports (all bound to 127.0.0.1) ------------------------------------
# 5435/6381 avoid clashing with other local Postgres/Redis (5432/5433/6379/6380).
TRAVELORAI_PG_PORT=5435
TRAVELORAI_REDIS_PORT=6381
TRAVELORAI_BACKEND_PORT=4000
TRAVELORAI_WEBSITE_PORT=3000
# 127.0.0.1 = only this PC. Set 0.0.0.0 to let a phone on the same Wi-Fi reach
# the API (mobile app with EXPO_PUBLIC_API_URL=http://<LAN-IP>:4000/api/v1).
TRAVELORAI_BACKEND_BIND=127.0.0.1

# ---- Local database password (dev only) --------------------------------------
# Used for the compose Postgres (db travelorai_db, user travelorai).
# Changing it after the volume exists has no effect — run `docker compose down -v` first.
TRAVELORAI_PG_PASSWORD=travelorai_pass

# ---- Optional ---------------------------------------------------------------
# Google Sign-In button on the website (public web client id).
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Backend base URL. Release builds accept https only and otherwise fall back to
# https://travelorai.com/api/v1. For local development you may leave it empty:
# __DEV__ builds then auto-detect the Metro host / Android emulator (port below).
EXPO_PUBLIC_API_URL=https://travelorai.com/api/v1
EXPO_PUBLIC_API_PORT=4000

# Google Sign-In
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID_DEBUG=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID_RELEASE=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
